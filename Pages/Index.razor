}
else
{
    <MudTabs @bind-ActivePanelIndex="TabState" Border="true" Outlined="true" PanelClass="px-4 py-6" ApplyEffectsToContainer="true">
        <ChildContent>
            <MudTabPanel Text="Календарь">
                <CustomCalendar MonthCellMinHeight="100" DayCellHeight="100" DayItemMinHeight="100" DateRangeChanged="CalendarRangeChanged" Items="@GetEventsByRange()" ItemClicked="CalendarItemClick"  Use24HourClock="true" Color="Color.Dark" FirstDayOfWeek="DayOfWeek.Monday" ShowTodayButton="true" ButtonVariant="Variant.Outlined">
                    <CellTemplate>
                        <div style="width: 100%; height: 100%; border: 2px solid @GetColor((context as ClientEvent).GetInfoColor())">
                            <div style="background-color: @GetColor((context as ClientEvent).GetInfoColor())">
                                <MudText Style="color: #ffffff;" Typo="Typo.body1" Align="Align.Center">@clients.First(var => var.Id == (context as ClientEvent).ClientId).ToString()</MudText>
                            </div>
                            <div class="pa-2">
                                <MudText Typo="Typo.body2">@context.Text</MudText>
