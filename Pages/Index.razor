@page "/"
@inherits LayoutComponentBase

@using System.Globalization
@using System.Reflection.Emit
@using System.Runtime.InteropServices.JavaScript
@using BlazorDexie.JsModule
@using Tetramorph.Doctor.Components
@using Tetramorph.Doctor.Database
@using Tetramorph.Doctor.Database.Models
@using Tetramorph.Doctor.Dialogs
@using Tetramorph.Doctor.Models

@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LocalStorageAccessor LocalStorageAccessor
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h3">События</MudText>
<br/>
<br/>
<br/>

@if (selectedClients != null && selectedClients.Any())
{
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Inline="true">@selectedClients.First().ToString()</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => ClearSelectedClients()"/>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <div class="pa-4 align-start d-flex">
                <div>
                    <MudText Typo="Typo.h6">Дата рождения: <MudText Typo="Typo.h5" Inline="true">@(selectedClients.First().BirthDate.ToString("dd.MM.yyyy", new CultureInfo("ru-RU")))</MudText></MudText>
                </div>
                <MudSpacer/>
                <div>
                    <MudText Typo="Typo.h5" Inline="true">@(GetSexName(selectedClients.First().Sex))</MudText>
                </div>
            </div>
            <div class="pa-4 align-start d-flex">
                <MudText Typo="Typo.h6">Лекарства: <MudText Typo="Typo.h5" Inline="false">@GetDrugsSummary(selectedClients.First())</MudText></MudText>
            </div>
            <div class="pa-4 align-start d-flex">
                <div>
                    @foreach (var testsName in selectedClients.First().Diagnosis)
                    {
                        <MudChip Style="height: 120px;" T="string" Size="Size.Small" Color="Color.Dark" Text="@(testsName.ToString())"/>
                    }
                </div>
                <MudSpacer/>
                <div>
                    <MudText Typo="Typo.h6">Следующая консультация: <MudText Typo="Typo.h5" Inline="false">@(GetNextConsultation(selectedClients.First()))</MudText></MudText>
                </div>
            </div>
        </MudCardContent>
        <MudCardActions>
        </MudCardActions>
    </MudCard>
}
else
{
    <MudPaper Outlined="true">
        <CustomAutocomplete T="ClientData"
                            PreloadedItems="clients"
                            Label="Клиенты"
                            MultiSelection="true"
                            Variant="Variant.Outlined"
                            ToStringFunc="@(e => $"№{e.CardNumber} - {e.Name}")"
                            SearchFunc="@ClientsSearchFunction"
                            @bind-SelectedValues="@selectedClients"/>
    </MudPaper>
}
<br/>

@if (IsList)
{
    <MudTabs @bind-ActivePanelIndex="TabState" Border="true" Outlined="true" PanelClass="px-4 py-6" ApplyEffectsToContainer="true">
        <ChildContent>
            <MudTabPanel Text="События">
                <MudGrid>
                    <MudItem xs="5">
                        <MudSelect @bind-Value="EventType" T="TypeofEvent" ToStringFunc="ClientEvent.EventTypeToStringFunc" Label="Тип события" Variant="Variant.Outlined">
                            <MudSelectItem Value="TypeofEvent.All"/>
                            <MudSelectItem Value="TypeofEvent.Consultation"/>
                            <MudSelectItem Value="TypeofEvent.StartTakingDrugs"/>
                            <MudSelectItem Value="TypeofEvent.DosageChange"/>
                            <MudSelectItem Value="TypeofEvent.EndTakingDrugs"/>
                            <MudSelectItem Value="TypeofEvent.Analysis"/>
                            <MudSelectItem Value="TypeofEvent.ProlongInjection"/>
                            <MudSelectItem Value="TypeofEvent.Note"/>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="7" Class="align-self-center">
                        <MudToggleGroup T="int" SelectionMode="SelectionMode.SingleSelection" @bind-Value="viewMode" Vertical="false" Outlined="true" Delimiters="true" Size="Size.Medium" Color="Color.Dark" Rounded="true" CheckMark="false" Disabled="false">
                            <MudToggleItem Value="@(0)">
                                В прошлом
                            </MudToggleItem>
                            <MudToggleItem Value="@(1)">
                                Ближайшие 4 дня
                            </MudToggleItem>
                            <MudToggleItem Value="@(2)">
                                Будущие
                            </MudToggleItem>
                        </MudToggleGroup>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTimeline TimelineAlign="TimelineAlign.Start" TimelinePosition="TimelinePosition.Alternate">
                            <Virtualize Context="userEvent" Items="@GetEvents(clientsEvents, false)" ItemSize="400">
                                <EventsTimelineItem EventData="@userEvent" Clients="@clients" UpdateState="@(() => UpdateState(userEvent))" EditEvent="@(() => EditEvent(userEvent))"/>
                            </Virtualize>
                        </MudTimeline>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Задачи">
                <MudGrid>
                    <MudItem xs="5">
                        <MudSelect @bind-Value="EventType" T="TypeofEvent" ToStringFunc="ClientEvent.EventTypeToStringFunc" Label="Тип события" Variant="Variant.Outlined">
                            <MudSelectItem Value="TypeofEvent.All"/>
                            <MudSelectItem Value="TypeofEvent.Consultation"/>
                            <MudSelectItem Value="TypeofEvent.StartTakingDrugs"/>
                            <MudSelectItem Value="TypeofEvent.DosageChange"/>
                            <MudSelectItem Value="TypeofEvent.EndTakingDrugs"/>
                            <MudSelectItem Value="TypeofEvent.Analysis"/>
                            <MudSelectItem Value="TypeofEvent.ProlongInjection"/>
                            <MudSelectItem Value="TypeofEvent.Note"/>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="7" Class="align-self-center">
                        <MudToggleGroup T="int" SelectionMode="SelectionMode.SingleSelection" @bind-Value="StateViewMode" Outlined="true" Delimiters="true" Size="Size.Medium" Color="Color.Dark" Rounded="true" CheckMark="false" Disabled="false">
                            <MudToggleItem Value="@(0)">
                                Планы
                            </MudToggleItem>
                            <MudToggleItem Value="@(1)">
                                Завершённые
                            </MudToggleItem>
                            <MudToggleItem Value="@(2)">
                                Отменённые
                            </MudToggleItem>
                        </MudToggleGroup>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTimeline TimelineAlign="TimelineAlign.Start" TimelinePosition="TimelinePosition.Alternate">
                            <Virtualize Context="userEvent" Items="@GetEvents(clientsEvents)" ItemSize="400">
                                <EventsTimelineItem EventData="@userEvent" Clients="@clients" UpdateState="@(() => UpdateState(userEvent))" EditEvent="@(() => EditEvent(userEvent))"/>
